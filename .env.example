# ============================================================
# Campus Collaborative Study (UTB) — Environment Variables
# Copia este archivo a .env y completa los valores según el entorno.
# NUNCA commitear .env
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Campus Collaborative Study
APP_VERSION=1.0.0

# --- Database (Supabase PostgreSQL / Prisma) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_study"
# En producción (Supabase):
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# --- Auth ---
JWT_SECRET=cambia_por_un_secreto_muy_largo_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Email (verificación y recuperación) ---
# Opciones: SMTP, SendGrid, Mailgun, Resend
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@utb.edu.co
SMTP_PASS=contraseña_de_aplicacion
EMAIL_FROM=Campus Collaborative Study <noreply@utb.edu.co>
# SendGrid:
# SENDGRID_API_KEY=SG.xxxx
# Resend:
# RESEND_API_KEY=re_xxxx

# --- WebSocket / Realtime ---
# Supabase Realtime (recomendado)
WS_URL=wss://tu-proyecto.supabase.co/realtime/v1
# Socket.io alternativo:
# SOCKET_IO_CORS=http://localhost:3000

# --- Redis (cache, rate limiting, colas para expiración de tutorías) ---
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# --- Third-party services (futuro) ---
# Jitsi (videollamada)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_SECRET=
# tldraw (pizarra)
TLdraw_API_KEY=
# LiveKit (videollamada alternativa)
LIVEKIT_URL=wss://tu-server.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Storage (archivos de materiales) ---
# Supabase Storage
STORAGE_BUCKET=campus-study-files
SUPABASE_STORAGE_URL=https://tu-proyecto.supabase.co/storage/v1

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Security ---
CORS_ORIGIN=http://localhost:3000
TRUSTED_PROXY=1

# --- Monitor role auto-approval (solo para desarrollo) ---
MONITOR_AUTO_APPROVE=false