# ============================================================
# Campus Collaborative Study (UTB) — Backend Environment
# Copia este archivo a backend/.env y completa los valores.
# NUNCA commitear backend/.env
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
APP_NAME=Campus Collaborative Study

# Carpeta donde se guardan los materiales de estudio.
# Si se omite, se usa backend/uploads (ignorada por Git).
# UPLOADS_DIR=

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_study"

# --- Auth ---
JWT_SECRET=cambia_por_un_secreto_muy_largo_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- Email (SMTP) ---
# Si no hay SMTP configurado, el backend imprime los enlaces en la consola.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Campus Collaborative Study <noreply@utb.edu.co>

# --- Scheduler de tutorías ---
# Expira solicitudes y envía recordatorios mientras el backend esté encendido.
SCHEDULER_ENABLED=true
# Cada cuánto corre el ciclo, en milisegundos (60000 = 1 minuto).
SCHEDULER_INTERVAL_MS=60000
# Minutos de anticipación con los que se envía el recordatorio.
RECORDATORIO_MINUTOS=60

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# --- Seed admin (creado al correr `npm run seed`) ---
ADMIN_EMAIL=admin@utb.edu.co
ADMIN_PASSWORD=Admin1234!
ADMIN_NOMBRE=Administrador UTB

# --- CORS ---
CORS_ORIGIN=http://localhost:3000