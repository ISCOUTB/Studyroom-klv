{
  "name": "studyroom-klv",
  "version": "1.0.0",
  "description": "StudyRoom - Universidad Tecnológica de Bolívar (UTB)",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "cd backend && npm run seed",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "keywords": [
    "utb",
    "studyroom",
    "colaborativo",
    "tutorias",
    "nextjs",
    "prisma"
  ],
  "author": "Equipo Studyroom-klv",
  "license": "ISC",
  "devDependencies": {
    "prisma": "^5.10.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  }
}
