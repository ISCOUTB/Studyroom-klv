// ============================================================
// Prisma Schema — StudyRoom (UTB)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolEnum {
  ESTUDIANTE
  TUTOR
  ADMINISTRADOR
}

enum EstadoSalaEnum {
  ACTIVA
  PROGRAMADA
  FINALIZADA
}

enum PrivacidadSalaEnum {
  PUBLICA
  PRIVADA
}

enum EstadoTutoriaEnum {
  SOLICITADA
  AGENDADA
  RECHAZADA
  EXPIRADA
  CANCELADA
  FINALIZADA
}

enum ModalidadEnum {
  VIRTUAL
  PRESENCIAL
}

enum EstadoParticipacionEnum {
  ACTIVO
  ABANDONO
}

enum TipoNotificacionEnum {
  TUTORIA_SOLICITADA
  TUTORIA_ACEPTADA
  TUTORIA_RECHAZADA
  TUTORIA_CANCELADA
  TUTORIA_FINALIZADA
  TUTORIA_EXPIRADA
  TUTORIA_RECORDATORIO
  MONITOR_APROBADO
  MONITOR_RECHAZADO
  SOLICITUD_MONITOR
  FORO_RESPUESTA
  FORO_ACEPTADA
}

enum TipoReporteEnum {
  MATERIAL
  PREGUNTA
  RESPUESTA
  MENSAJE
}

enum EstadoReporteEnum {
  PENDIENTE
  RESUELTO
}

model Usuario {
  id                String         @id @default(uuid())
  nombre            String
  apellido          String?
  correoUnico       String         @unique @map("correo_unico")
  contrasenaHash    String         @map("contrasena_hash")
  salt              String
  rol               RolEnum        @default(ESTUDIANTE)
  ciudad            String?
  pais              String         @default("Colombia")
  zonaHoraria       String         @default("America/Bogota") @map("zona_horaria")
  visibilidadCorreo String         @default("CURSO") @map("visibilidad_correo")
  fotoUrl           String?        @map("foto_url")
  emailVerificado   Boolean        @default(false) @map("email_verificado")
  tokenVerificacion String?        @map("token_verificacion")
  resetToken        String?        @map("reset_token")
  resetTokenExp     DateTime?      @map("reset_token_exp")
  creadoEn          DateTime       @default(now()) @map("creado_en")
  actualizadoEn     DateTime       @updatedAt @map("actualizado_en")

  estudiante        Estudiante?
  tutor             Tutor?
  administrador     Administrador?
  salasAnfitrion    SalaEstudio[]  @relation("AnfitrionSalas")
  participaciones   ParticipacionSala[]
  mensajes          MensajeChat[]
  materiales        MaterialEstudio[]
  tutoriasSolicitadas Tutoria[]    @relation("SolicitanteTutorias")
  notificaciones    Notificacion[]
  trazosPizarra     TrazoPizarra[]
  preguntasForo     Pregunta[]      @relation("PreguntasForo")
  respuestasForo    Respuesta[]     @relation("RespuestasForo")
  reportesCreados   Reporte[]       @relation("ReportesCreados")
  reportesResueltos Reporte[]       @relation("ReportesResueltos")
  auditoria         RegistroAuditoria[] @relation("AuditoriaAdmin")

  @@map("usuarios")
}

model Estudiante {
  id        String   @id
  usuario   Usuario  @relation(fields: [id], references: [id], onDelete: Cascade)
  carrera   String
  semestre  Int
  fotoUrl   String?  @map("foto_url")

  @@map("estudiantes")
}

model Tutor {
  id            String       @id
  usuario       Usuario      @relation(fields: [id], references: [id], onDelete: Cascade)
  carrera       String
  semestre      Int
  fotoUrl       String?      @map("foto_url")
  biografia     String?      @db.VarChar(300)
  modalidad     ModalidadEnum @default(VIRTUAL)
  ubicacion     String?      // ej: "Bloque C · Salón 204"
  asignaturas   String[]     // ["Cálculo I", "Física I", etc.]
  aprobado      Boolean      @default(false)
  solicitudEn   DateTime     @default(now()) @map("solicitud_en")

  disponibilidades DisponibilidadMonitor[]
  tutoriasAsignadas Tutoria[]              @relation("MonitorTutorias")

  @@map("tutores")
}

model Administrador {
  id      String   @id
  usuario Usuario  @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("administradores")
}

model SalaEstudio {
  id            String             @id @default(uuid())
  anfitrionId   String             @map("anfitrion_id")
  anfitrion     Usuario            @relation("AnfitrionSalas", fields: [anfitrionId], references: [id])
  titulo        String
  asignatura    String             // Cálculo | Física | Álgebra | Estadística
  tema          String
  descripcion   String
  cupoMaximo    Int                @default(10) @map("cupo_maximo")
  privacidad    PrivacidadSalaEnum @default(PUBLICA)
  estado        EstadoSalaEnum     @default(ACTIVA)
  programadaEn  DateTime?          @map("programada_en")
  codigoAcceso  String?            @unique @map("codigo_acceso")
  creadoEn      DateTime           @default(now()) @map("creado_en")

  participantes ParticipacionSala[]
  mensajes      MensajeChat[]
  materiales    MaterialEstudio[]
  trazosPizarra TrazoPizarra[]

  @@map("salas_estudio")
}

model ParticipacionSala {
  id          String                  @id @default(uuid())
  salaId      String                  @map("sala_id")
  sala        SalaEstudio             @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuarioId   String                  @map("usuario_id")
  usuario     Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unioEn      DateTime                @default(now()) @map("unio_en")
  estado      EstadoParticipacionEnum @default(ACTIVO)

  @@unique([salaId, usuarioId])
  @@map("participacion_sala")
}

model Tutoria {
  id              String            @id @default(uuid())
  solicitanteId   String            @map("solicitante_id")
  solicitante     Usuario           @relation("SolicitanteTutorias", fields: [solicitanteId], references: [id])
  monitorId       String            @map("monitor_id")
  monitor         Tutor             @relation("MonitorTutorias", fields: [monitorId], references: [id])
  disponibilidadId String?          @map("disponibilidad_id")
  disponibilidad  DisponibilidadMonitor? @relation(fields: [disponibilidadId], references: [id], onDelete: SetNull)
  estado          EstadoTutoriaEnum @default(SOLICITADA)
  solicitadaEn    DateTime          @default(now()) @map("solicitada_en")
  expiraEn        DateTime          @map("expira_en") // min(solicitadaEn + 24 h, inicio del bloque)
  respondidaEn    DateTime?         @map("respondida_en")
  programadaEn    DateTime?         @map("programada_en")
  recordatorioEnviadoEn DateTime?   @map("recordatorio_enviado_en")
  modalidad       ModalidadEnum     @default(VIRTUAL)
  ubicacion       String?
  notas           String?
  calificacion    Int?

  @@index([monitorId, programadaEn])
  @@index([solicitanteId, estado])
  @@index([estado, recordatorioEnviadoEn, programadaEn])
  @@map("tutorias")
}

model DisponibilidadMonitor {
  id        String   @id @default(uuid())
  tutorId   String   @map("tutor_id")
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  fecha     DateTime @db.Date
  horaIni   String   @map("hora_ini") // formato "09:00"
  horaFin   String   @map("hora_fin") // formato "10:00"
  diaSemana String   @map("dia_semana") // Lun | Mar | Mié | Jue | Vie
  tutorias  Tutoria[]

  @@unique([tutorId, fecha, horaIni])
  @@index([tutorId, fecha])
  @@map("disponibilidad_monitor")
}

model MensajeChat {
  id        String      @id @default(uuid())
  salaId    String      @map("sala_id")
  sala      SalaEstudio @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuarioId String      @map("usuario_id")
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contenido String
  enviadoEn DateTime    @default(now()) @map("enviado_en")

  @@map("mensajes_chat")
}

model MaterialEstudio {
  id             String      @id @default(uuid())
  salaId         String      @map("sala_id")
  sala           SalaEstudio @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuarioId      String      @map("usuario_id")
  usuario        Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombreOriginal String      @map("nombre_original")
  nombreArchivo  String      @map("nombre_archivo")
  tipoMime       String      @map("tipo_mime")
  tamano         Int
  descripcion    String?     @db.VarChar(300)
  creadoEn       DateTime    @default(now()) @map("creado_en")

  @@index([salaId, creadoEn])
  @@map("materiales_estudio")
}

model TrazoPizarra {
  id        String      @id @default(uuid())
  salaId    String      @map("sala_id")
  sala      SalaEstudio @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuarioId String      @map("usuario_id")
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String      // trazo | texto
  color     String
  grosor    Int
  datos     Json        // { puntos: [{x,y}], texto?, x?, y? } en coordenadas 0..1
  creadoEn  DateTime    @default(now()) @map("creado_en")

  @@index([salaId, creadoEn])
  @@map("pizarra_trazos")
}

model Notificacion {
  id        String                 @id @default(uuid())
  usuarioId String                 @map("usuario_id")
  usuario   Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacionEnum
  titulo    String                 @db.VarChar(120)
  mensaje   String                 @db.VarChar(300)
  enlace    String?                @db.VarChar(200)
  leida     Boolean                @default(false)
  creadaEn  DateTime               @default(now()) @map("creada_en")

  @@index([usuarioId, leida, creadaEn])
  @@map("notificaciones")
}

model Pregunta {
  id          String    @id @default(uuid())
  autorId     String    @map("autor_id")
  autor       Usuario   @relation("PreguntasForo", fields: [autorId], references: [id], onDelete: Cascade)
  titulo      String    @db.VarChar(150)
  descripcion String    @db.VarChar(1000)
  asignatura  String
  tema        String?   @db.VarChar(80)
  resuelta    Boolean   @default(false)
  creadoEn    DateTime  @default(now()) @map("creado_en")

  respuestas  Respuesta[]

  @@index([asignatura, resuelta, creadoEn])
  @@index([creadoEn])
  @@map("preguntas_foro")
}

model Respuesta {
  id         String   @id @default(uuid())
  preguntaId String   @map("pregunta_id")
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  autorId    String   @map("autor_id")
  autor      Usuario  @relation("RespuestasForo", fields: [autorId], references: [id], onDelete: Cascade)
  contenido  String   @db.VarChar(1000)
  aceptada   Boolean  @default(false)
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@index([preguntaId, creadoEn])
  @@map("respuestas_foro")
}

// ------------------------------------------------------------
// Catálogo de asignaturas (RF-18)
// ------------------------------------------------------------
model Asignatura {
  id           String   @id @default(uuid())
  nombre       String   @unique
  color        String   @default("blue")
  activa       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("asignaturas")
}

// ------------------------------------------------------------
// Moderación: reportes de contenido
// ------------------------------------------------------------
model Reporte {
  id            String             @id @default(uuid())
  tipo          TipoReporteEnum
  referenciaId  String             @map("referencia_id")
  motivo        String             @db.VarChar(500)
  reportanteId  String             @map("reportante_id")
  reportante    Usuario            @relation("ReportesCreados", fields: [reportanteId], references: [id], onDelete: Cascade)
  estado        EstadoReporteEnum  @default(PENDIENTE)
  resueltoPorId String?            @map("resuelto_por_id")
  resueltoPor   Usuario?           @relation("ReportesResueltos", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  resueltoEn    DateTime?          @map("resuelto_en")
  creadoEn      DateTime           @default(now()) @map("creado_en")

  @@index([estado, creadoEn])
  @@index([tipo, referenciaId])
  @@map("reportes")
}

// ------------------------------------------------------------
// Auditoría de acciones administrativas
// ------------------------------------------------------------
model RegistroAuditoria {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  admin     Usuario  @relation("AuditoriaAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  accion    String   @db.VarChar(120)
  detalle   String   @db.VarChar(500)
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@map("registro_auditoria")
}
